{
  "name": "skill-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"corepack pnpm --filter @skill-manager/api dev\" \"corepack pnpm --filter @skill-manager/web dev\"",
    "dev:acceptance": "concurrently \"tsx apps/api/src/server.ts\" \"corepack pnpm --filter @skill-manager/web preview\"",
    "build": "corepack pnpm -r build",
    "package:local": "corepack pnpm build && node scripts/package-local.mjs",
    "package:windows": "corepack pnpm package:local && node scripts/build-windows-installer.mjs",
    "test": "corepack pnpm exec vitest run",
    "test:watch": "corepack pnpm exec vitest",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
