{
  "name": "@skill-manager/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --target=node24",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@skill-manager/shared": "workspace:*",
    "fastify": "^5.6.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}
